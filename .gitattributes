# Keep text files in the repository on LF so formatting checks are identical
# on Windows, Linux, and CI. Windows launchers stay CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.java text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.png binary
*.ogg binary
*.nbt binary
*.jar binary
*.zip binary
